+def _litedsa_try(q, kv_c_and_k_pe_cache, topk_indices, req_id_per_token,
+                 block_table, block_size, num_heads, bmm1_scale, bmm2_scale,
+                 group_size, version):
+    """Returns the attention output, or None if the hook is unavailable or
+    declines (caller falls through to the stock per-token path)."""
+    global _LITEDSA_MOD, _LITEDSA_OFF
+    if _LITEDSA_OFF:
+        return None
+    if _LITEDSA_MOD is None:
+        try:
+            import sys as _sys
+            _p = os.environ.get("LITETOPK_MODULE_DIR")
+            if _p and _p not in _sys.path:
+                _sys.path.insert(0, _p)
+            import litedsa_attn as _LITEDSA_MOD_  # noqa: N813
+            _LITEDSA_MOD = _LITEDSA_MOD_
+            logger.info("LiteDSA grouped-attention hook enabled")
+        except Exception as e:  # noqa: BLE001
+            logger.warning("LiteDSA hook import failed, disabled: %s", e)
+            _LITEDSA_OFF = True
+            return None
+    if not _LITEDSA_MOD.litedsa_available():
+        _LITEDSA_OFF = True
+        return None
+    return _LITEDSA_MOD.litedsa_masked_mqa(
+        q, kv_c_and_k_pe_cache, topk_indices, req_id_per_token, block_table,
+        block_size, num_heads, bmm1_scale, bmm2_scale, group_size, version,
+    )
