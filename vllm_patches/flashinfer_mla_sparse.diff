+# ---- LiteDSA grouped sparse attention hook (VLLM_LITETOPK_LITEDSA=1) ------
+_LITEDSA_MOD = None
+_LITEDSA_OFF = os.environ.get("VLLM_LITETOPK_LITEDSA", "0") != "1"
